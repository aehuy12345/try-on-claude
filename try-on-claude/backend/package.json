{
  "name": "try-on-backend",
  "version": "1.0.0",
  "description": "Try-on REST API (Express + Supabase)",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --import ./test/setup.js --test test/profile.validator.test.js test/profile.http.test.js test/body-parsing.http.test.js test/auth-token.http.test.js test/signed-url-ttl.test.js test/rate-limit.http.test.js test/body-photo.processor.test.js test/body-photo.http.test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "type": "module",
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
